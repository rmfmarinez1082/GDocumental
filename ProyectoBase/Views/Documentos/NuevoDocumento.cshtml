<script src="~/assets/js/jquery/jquery.min.js"></script>

<script>
    // ============================================
    // NAVEGACIÓN DEL STEPPER
    // ============================================
    var currentStep = 1;
    var totalSteps = 4;

    function getCurrentVisibleStep() {
        var visible = 1;
        $('.step-panel').each(function (index) {
            if ($(this).hasClass('active')) {
                visible = index + 1;
            }
        });
        return visible;
    }

    function goToStep(step) {
        if (step < 1 || step > totalSteps) return;

        // Ocultar panel actual
        $('.step-panel').removeClass('active');
        $('#step' + step).addClass('active');

        // Actualizar stepper visual
        $('.stepper-step').removeClass('active completed');

        for (var i = 1; i <= totalSteps; i++) {
            var stepEl = $('.stepper-step[data-step="' + i + '"]');
            if (i < step) {
                stepEl.addClass('completed');
            } else if (i === step) {
                stepEl.addClass('active');
            }
        }

        // Actualizar barra de progreso
        var progress = ((step - 1) / (totalSteps - 1)) * 100;
        $('#stepperProgress').css('width', progress + '%');
        // Sincronizar variable
        currentStep = step;

        // Scroll al top
        $('html, body').animate({ scrollTop: $('.documento-card').offset().top - 20 }, 300);
    }

    function nextStep() {
        var current = getCurrentVisibleStep();
        if (current < totalSteps) {
            goToStep(current + 1);
        }
    }

    function prevStep() {
        var current = getCurrentVisibleStep();
        if (current > 1) {
            goToStep(current - 1);
        }
    }

    // Click en círculos del stepper
    $(document).on('click', '.stepper-circle', function (e) {
        e.preventDefault();
        var step = $(this).closest('.stepper-step').data('step');
        goToStep(step);
    });

    // ============================================
    // MENÚ ACTIVO
    // ============================================
    $('#agregardoc').addClass("active");
    $('#menuDocumentos').addClass("active pcoded-trigger");

    // ============================================
    // FUNCIONES DE VALIDACIÓN Y NAVEGACIÓN
    // ============================================
    function Descripcion() {
        if (ValidaDescripcion()) {
            nextStep();
        } else {
            $.notify("Completa todos los campos requeridos.", "error");
        }
    }

    function Control() {
        if (ValidaControl()) {
            nextStep();
        } else {
            $.notify("Completa las fechas requeridas.", "error");
        }
    }

    function clasificacion() {
        if (Validaclasificacion()) {
            nextStep();
        } else {
            $.notify("Selecciona la carpeta y clasificación.", "error");
        }
    }

    function ValidaDescripcion() {
        var result = false;
        var fields = ['#TipoDocumento', '#Version', '#NombreDocumento', '#Descripcion'];

        // Reset styles
        fields.forEach(function (field) {
            $(field).removeClass('error');
        });

        // Validate
        if ($('#TipoDocumento').val() > 0) {
            if ($('#Version').val().length > 0) {
                if ($('#NombreDocumento').val().length > 0) {
                    /*if ($('#PalabraClave').val().length > 0) {*/
                        if ($('#Descripcion').val().length > 0) {
                            result = true;
                        } else { $('#Descripcion').addClass('error'); }
                    /*} else { $('#PalabraClave').addClass('error'); }*/
                } else { $('#NombreDocumento').addClass('error'); }
            } else { $('#Version').addClass('error'); }
        } else { $('#TipoDocumento').addClass('error'); }

        return result;
    }

    function Validaclasificacion() {
        var result = false;
        var node = $('#jstree').jstree().get_selected("id");

        $('#Clasificacion').removeClass('error');

        if ($('#Clasificacion').val() == 0) {
            $('#Clasificacion').addClass('error');
            return false;
        }

        if (node == "") {
            swal({
                title: "Selecciona una carpeta",
                text: "Debes seleccionar la carpeta donde se guardará el documento",
                icon: "warning",
                button: "Aceptar"
            });
            return false;
        }

        $.notify("El documento se guardará en: " + node[0].text, "info");
        return true;
    }

    // ============================================
    // CONTADOR DE CARACTERES
    // ============================================
    function countChars(obj) {
        var maxLength = 150;
        var strLength = obj.value.length;
        var charRemain = maxLength - strLength;
        var counter = $('#charNum');

        if (charRemain < 0) {
            counter.html('<span class="exceeded">' + Math.abs(charRemain) + ' caracteres de más</span>');
        } else {
            counter.removeClass('exceeded').html(charRemain + ' caracteres restantes');
        }
    }

    // ============================================
    // UPPERCASE EN CAMPOS
    // ============================================
    ['NombreDocumento', 'PalabraClave', 'Descripcion'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.addEventListener('keyup', function () {
                this.value = this.value.toUpperCase();
            });
        }
    });

    // ============================================
    // CARGAR RESUMEN
    // ============================================
    function CargaResumen() {
        $('#SP_CategoriaArticulo').text($('#NombreDocumento').val() || '-');
        $('#SP_SubcategoriaArticulo').text($('#Version').val() || '-');
        $('#SP_ClasificacionArticulo').text($('#TipoDocumento option:selected').text() || '-');
       /* $('#SP_FlujoOperacionArticulo').text($('#PalabraClave').val() || '-');*/
        $('#SP_Descripcion').text($('#Descripcion').val() || '-');

        $('#SP_FechaRevision').text($('#FechaRevision').val() || '-');
        $('#SP_Fechadeentradaenvigor').text($('#Fechadeentradaenvigor').val() || '-');
        $('#SP_FechaPublicacion').text($('#FechaPublicacion').val() || '-');
        $('#SP_FechaVencimiento').text($('#FechaVencimiento').val() || '-');
        $('#SP_FechaProximaRevision').text($('#FechaProximaRevision').val() || '-');

        $('#SP_Select_Clasificacion').text($('#Clasificacion option:selected').text() || '-');
    }

    // ============================================
    // DATEPICKERS
    // ============================================
    $(document).ready(function () {
        $.datepicker.regional['es'] = {
            closeText: 'Cerrar',
            prevText: '< Ant',
            nextText: 'Sig >',
            currentText: 'Hoy',
            monthNames: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
            monthNamesShort: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
            dayNames: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
            dayNamesShort: ['Dom', 'Lun', 'Mar', 'Mié', 'Juv', 'Vie', 'Sáb'],
            dayNamesMin: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá'],
            weekHeader: 'Sm',
            dateFormat: 'dd/mm/yy',
            firstDay: 1,
            isRTL: false,
            showMonthAfterYear: false,
            yearSuffix: '',
            showAnim: 'fadeIn'
        };
        $.datepicker.setDefaults($.datepicker.regional['es']);

        $('#FechaVencimiento, #FechaProximaRevision, #Fechadeentradaenvigor, #FechaPublicacion, #FechaRevision').datepicker();
    });
</script>

<!-- El resto de las funciones del archivo original se mantienen igual -->
<script>
// ============================================
// FUNCIONES DE CARGA DE ARCHIVOS (ORIGINALES)
// ============================================
function Publicar() {
    if (ValidaDescripcion()) {
        if (ValidaControl()) {
            if (Validaclasificacion()) {
                if (ValidaDocumento()) {
                    if (RequiereEditable()) {
                        if (ValidaDocumentoWord()) {
                            $("#BtnPublicar").prop('disabled', true);

                            var obj = {
                                'Nombre': $("#NombreDocumento").val(),
                                'Version': $("#Version").val(),
                                'IdTipoDocumento': $("#TipoDocumento option:selected").val(),
                                'PalabraClave': $("#PalabraClave").val(),
                                'Descripcion': $("#Descripcion").val(),
                                'FechaRevision': $("#FechaRevision").val(),
                                'Fechadeentradaenvigor': $("#Fechadeentradaenvigor").val(),
                                'FechaPublicacion': $("#FechaPublicacion").val(),
                                'FechaVencimiento': $("#FechaVencimiento").val(),
                                'FechaProximaRevision': $("#FechaProximaRevision").val(),
                                'IdClasificacion': $("#Clasificacion option:selected").val(),
                                'Idtemporal': $('#jstree').jstree().get_selected("id")[0].id
                            };

                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("Documentos_Registrar", "Documentos")",
                                async: false,
                                data: JSON.stringify({ "NuevoDocumento": obj }),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function(data) {
                                    if (data.Id == -1) {
                                        swal({ title: "El documento ya existe.", icon: "warning", button: "Aceptar" });
                                    } else if (data.Id == 0) {
                                        swal({ title: "Error al registrar.", icon: "warning", button: "Aceptar" });
                                    } else if (data.Id > 0) {
                                        swal({ title: "Documento registrado!", icon: "success", button: "Aceptar" })
                                            .then(() => location.reload());
                                    }
                                }
                            });
                            $("#BtnPublicar").prop('disabled', false);
                        } else {
                            swal({ title: "Falta el archivo editable", icon: "warning", button: "Aceptar" });
                            goToStep(3);
                        }
                    } else {
                        // Sin editable requerido
                        $("#BtnPublicar").prop('disabled', true);

                        var obj = {
                            'Nombre': $("#NombreDocumento").val(),
                            'Version': $("#Version").val(),
                            'IdTipoDocumento': $("#TipoDocumento option:selected").val(),
                            'PalabraClave': $("#PalabraClave").val(),
                            'Descripcion': $("#Descripcion").val(),
                            'FechaRevision': $("#FechaRevision").val(),
                            'Fechadeentradaenvigor': $("#Fechadeentradaenvigor").val(),
                            'FechaPublicacion': $("#FechaPublicacion").val(),
                            'FechaVencimiento': $("#FechaVencimiento").val(),
                            'FechaProximaRevision': $("#FechaProximaRevision").val(),
                            'IdClasificacion': $("#Clasificacion option:selected").val(),
                            'Idtemporal': $('#jstree').jstree().get_selected("id")[0].id
                        };

                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("Documentos_Registrar", "Documentos")",
                            async: false,
                            data: JSON.stringify({ "NuevoDocumento": obj }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function(data) {
                                if (data.Id > 0) {
                                    swal({ title: "Documento registrado!", icon: "success", button: "Aceptar" })
                                        .then(() => location.reload());
                                }
                            }
                        });
                        $("#BtnPublicar").prop('disabled', false);
                    }
                } else {
                    swal({ title: "Debes cargar un documento", icon: "warning", button: "Aceptar" });
                    goToStep(3);
                }
            } else {
                goToStep(3);
            }
        } else {
            goToStep(2);
        }
    } else {
        goToStep(1);
    }
}

function GuardarIMG() {
    if (ValidaDescripcion()) {
        if (ValidaControl()) {
            if (Validaclasificacion()) {
                fetch('/Imagen/ObtenerImagenesSesion')
                    .then(resp => resp.json())
                    .then(imagenes => {
                        if (imagenes.length > 0) {
                            var obj = {
                                'Nombre': $("#NombreDocumento").val(),
                                'Version': $("#Version").val(),
                                'IdTipoDocumento': $("#TipoDocumento option:selected").val(),
                                'PalabraClave': $("#PalabraClave").val(),
                                'Descripcion': $("#Descripcion").val(),
                                'FechaRevision': $("#FechaRevision").val(),
                                'Fechadeentradaenvigor': $("#Fechadeentradaenvigor").val(),
                                'FechaPublicacion': $("#FechaPublicacion").val(),
                                'FechaVencimiento': $("#FechaVencimiento").val(),
                                'FechaProximaRevision': $("#FechaProximaRevision").val(),
                                'IdClasificacion': $("#Clasificacion option:selected").val(),
                                'Idtemporal': $('#jstree').jstree().get_selected("id")[0].id
                            };

                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("RegistrarImg", "Imagen")",
                                async: false,
                                data: JSON.stringify({ "Registro": obj }),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json",
                                success: function(data) {
                                    if (data.Id > 0) {
                                        swal({ title: "Registro exitoso!", icon: "success", button: "Aceptar" })
                                            .then(() => location.reload());
                                    }
                                }
                            });
                        } else {
                            swal({ title: "Agrega al menos una imagen", icon: "warning", button: "Aceptar" });
                            goToStep(3);
                        }
                    });
            }
        }
    }
}

