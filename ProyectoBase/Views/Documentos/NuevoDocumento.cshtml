<div class="main-body">
    <div class="page-wrapper">
        <div class="page-body">
            <div class="row">
                <div class="col-12">

                    <div class="documento-card">
                        <!-- Header -->
                        <div class="documento-card-header">
                            <h5><i class="fa fa-file-text-o"></i> Nuevo Documento</h5>
                            <span>Completa los campos marcados con <strong>*</strong></span>
                        </div>

                        <div class="documento-card-body">
                            <!-- Stepper -->
                            <div class="stepper-container">
                                <div class="stepper">
                                    <div class="stepper-progress" id="stepperProgress" style="width: 0%;"></div>

                                    <div class="stepper-step active" data-step="1">
                                        <div class="stepper-circle" data-toggle="tab" href="#step1">
                                            <i class="fa fa-pencil"></i>
                                        </div>
                                        <span class="stepper-label">Descripción</span>
                                    </div>

                                    <div class="stepper-step" data-step="2">
                                        <div class="stepper-circle" data-toggle="tab" href="#step2">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <span class="stepper-label">Control</span>
                                    </div>

                                    <div class="stepper-step" data-step="3">
                                        <div class="stepper-circle" data-toggle="tab" href="#step3">
                                            <i class="fa fa-folder-open"></i>
                                        </div>
                                        <span class="stepper-label">Clasificación</span>
                                    </div>

                                    <div class="stepper-step" data-step="4">
                                        <div class="stepper-circle" data-toggle="tab" href="#step4">
                                            <i class="fa fa-cloud-upload"></i>
                                        </div>
                                        <span class="stepper-label">Publicar</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Contenido de pasos -->
                            <div class="step-content">

                                <!-- PASO 1: DESCRIPCIÓN -->
                                <div class="step-panel active" id="step1">
                                    <div class="step-title">
                                        <h3>Descripción del Documento</h3>
                                        <p>Ingresa la información básica del documento</p>
                                    </div>

                                    <!-- Alert de requisitos (se muestra dinámicamente) -->
                                    <div class="info-alert" id="DatosRequeridos" style="display: none;">
                                        <div class="info-alert-icon">
                                            <i class="fa fa-info"></i>
                                        </div>
                                        <div class="info-alert-content">
                                            <h6>Requisitos del tipo de documento</h6>
                                            <p>El tipo seleccionado requiere los siguientes elementos:</p>
                                            <div class="badge-list">
                                                <span class="badge-item" id="mensaje" style="display:none;">
                                                    <i class="fa fa-file-word-o"></i> Archivo editable
                                                </span>
                                                <span class="badge-item" id="Pdf" style="display:none;">
                                                    <i class="fa fa-file-pdf-o"></i> Archivo PDF
                                                </span>
                                                <span class="badge-item" id="imagenes" style="display:none;">
                                                    <i class="fa fa-image"></i> Imágenes
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-section">
                                        <div class="form-section-title">
                                            <i class="fa fa-info-circle"></i> Información General
                                        </div>

                                        <div class="form-row-custom">
                                            <div class="form-group-modern">
                                                <label><span class="required">*</span> Nombre (título)</label>
                                                <input type="text" class="form-control-modern" id="NombreDocumento"
                                                       placeholder="Ingresa el nombre del documento" onkeyup="countChars(this)">
                                                <div class="char-counter" id="charNum">150 caracteres restantes</div>
                                            </div>

                                            <div class="form-group-modern">
                                                <label><span class="required">*</span> Versión</label>
                                                <input type="number" class="form-control-modern" id="Version"
                                                       min="1" placeholder="Ej: 1">
                                            </div>

                                            <div class="form-group-modern">
                                                <label><span class="required">*</span> Tipo de Documento</label>
                                                <select class="form-control-modern" id="TipoDocumento"
                                                        onchange="ValidaTDoc(this.value), Fechas(this.value)">
                                                    <option value="0">Seleccionar tipo...</option>
                                                    @foreach (var item in ViewBag.dtTipoDocumentos)
                                                    {
                                                        <option value="@item.Id">@item.Nombre</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-row-custom" style="margin-top: 20px;">
                                            <div class="form-group-modern" style="display:none">
                                                <label><span class="required">*</span> Palabra Clave</label>
                                                <input type="text" class="form-control-modern" id="PalabraClave"
                                                       placeholder="Palabras clave para búsqueda" value="2026">
                                            </div>

                                            <div class="form-group-modern" style="grid-column: span 2;">
