// Carga de PDF
function BtnCargarPDF() { $("#fileInput2").click(); }

$('#fileInput2').change(function() {
    var fileInput = this;
    if (fileInput.files.length > 0) {
        var ext = fileInput.files[0].name.split('.').pop().toLowerCase();
        var filesize = ((fileInput.files[0].size / 1024) / 1024).toFixed(4);

        if (ext !== 'pdf') {
            swal({ title: "Solo archivos PDF", icon: "warning", button: "Aceptar" });
            return;
        }
        if (filesize > 60) {
            swal({ title: "Archivo muy grande (máx 60MB)", icon: "warning", button: "Aceptar" });
            return;
        }

        var formData = new FormData();
        formData.append(fileInput.files[0].name, fileInput.files[0]);

        $('#progressContainer').addClass('visible');

        $.ajax({
            url: '/api/FileAPI/UploadFilesArticulo',
            type: 'POST',
            data: formData,
            cache: false,
            contentType: false,
            processData: false,
            success: function(ListDocumentos) {
                $('#progressContainer').removeClass('visible');
                CargaDocumento(ListDocumentos);
            },
            xhr: function() {
                var xhr = $.ajaxSettings.xhr();
                if (xhr.upload) {
                    xhr.upload.addEventListener("progress", function(e) {
                        if (e.lengthComputable) {
                            $("#fileProgress").attr({ value: e.loaded, max: e.total });
                        }
                    }, false);
                }
                return xhr;
            }
        });
    }
});

function CargaDocumento(ListDocumentos) {
    $.ajax({
        type: "POST",
        url: "@Url.Action("CargaDocumentos", "Documentos")",
        async: false,
        data: JSON.stringify(ListDocumentos),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function(Contenido) {
            $('#iframepdf').attr('src', 'https://' + Contenido[0].DocumentoURL + '#toolbar=0');
            $('#Visualizacion').show();
        }
    });
}

// Carga de Word
function BtnCargarWord() { $("#fileInputword").click(); }

$('#fileInputword').change(function() {
    var fileInput = this;
    if (fileInput.files.length > 0) {
        var ext = fileInput.files[0].name.split('.').pop().toLowerCase();

        if (!['docx', 'pptx', 'xlsx', 'dwg'].includes(ext)) {
            swal({ title: "Formato no permitido", text: "Use: docx, pptx, xlsx, dwg", icon: "warning", button: "Aceptar" });
            return;
        }

        var formData = new FormData();
        formData.append(fileInput.files[0].name, fileInput.files[0]);

        $.ajax({
            url: '/api/FileAPI/SubirWord',
            type: 'POST',
            data: formData,
            cache: false,
            contentType: false,
            processData: false,
            success: function(ListDocumentos) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CargaDocumentosword", "Documentos")",
                    data: JSON.stringify(ListDocumentos),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function() {
                        swal({ title: "Documento cargado!", icon: "success", button: "Aceptar" });
                    }
                });
            }
        });
    }
});
</script>

<!-- ÁRBOL -->
<script>
$(document).ready(function() {
    var treeList = @Html.Raw(Json.Encode(ViewBag.ElementoOculto));
    var isAdmin = treeList.some(item => item.IdElemento === "TreeAdmin");

    var config = {
        'core': {
            'themes': { 'name': 'proton', 'responsive': true },
            'check_callback': isAdmin
        },
        'plugins': isAdmin ? ['contextmenu', 'dnd', 'state', 'wholerow', 'search'] : ['state', 'wholerow', 'search']
    };

    if (isAdmin) {
        config.contextmenu = {
            items: {
                "ccp": false,
                "create": {
                    "label": "Crear carpeta",
                    "action": function() {
                        var ref = $("#jstree").jstree(true);
                        var sel = ref.get_selected();
                        if (!sel.length) { alert("Seleccione primero un nodo"); return; }

                        sel = ref.create_node(sel[0]);
                        var nuevo = ref.get_node(sel);

                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("RegistrarSubClas", "Documentos")",
                            async: false,
                            data: JSON.stringify({ "nuevasubClas": { "Nombre": nuevo.text, "IdPadre": nuevo.parent, "Idtemporal": nuevo.id } }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function(data) {
                                if (data.Id == 1) { ref.edit(sel); } else { ref.delete_node(sel); }
                            }
                        });
                    }
                },
                "renombrar": {
                    "label": "Renombrar",
                    "action": function() {
                        var ref = $("#jstree").jstree(true);
                        var sel = ref.get_selected();
                        if (sel.length) ref.edit(sel[0]);
                    }
                },
                "eliminar": {
                    "label": "Eliminar",
                    "action": function() {
                        var ref = $("#jstree").jstree(true);
                        var sel = ref.get_selected();

                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("EliminarCarpeta", "Documentos")",
                            async: false,
                            data: JSON.stringify({ "carpeta": { "Idtemporal": sel[0] } }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function(data) {
                                if (data.Id == 1) {
                                    ref.delete_node(sel[0]);
                                    $.notify("Carpeta eliminada!", "success");
                                } else {
                                    swal({ title: "No se puede eliminar", icon: "warning", button: "Aceptar" });
                                }
                            }
                        });
                    }
                },
                "carpetaRoot": {
                    "label": "Crear carpeta principal",
                    "action": function() {
                        $("#jstree").jstree("create_node", null, null, "last", function(node) {
                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("RegistrarClas", "Documentos")",
                                async: false,
                                data: JSON.stringify({ "nuevaClas": { "Nombre": node.text, "Idtemporal": node.id } }),
                                contentType: "application/json; charset=utf-8",
                                dataType: "json"
                            });
                            this.edit(node);
                        });
                    }
                }
            }
        };
    }

    $('#jstree').jstree(config);

    // Búsqueda
    $('#plugins4_q').on('keyup', function() {
        $('#jstree').jstree(true).search($(this).val());
    });

    // Rename
    $('#jstree').on('rename_node.jstree', function(e, data) {
        data.node.text = data.text.toUpperCase();
        $.ajax({
            type: "POST",
            url: "@Url.Action("Renombrar", "Documentos")",
            async: false,
            data: JSON.stringify({ "carpeta": { "Nombre": data.node.text, "Idtemporal": data.node.id, "IdPadre": data.node.parent } }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function(data) {
                $.notify(data.Id == 1 ? "Cambios guardados" : "Error al renombrar", data.Id == 1 ? "success" : "error");
            }
        });
    });

    // Move
    $('#jstree').on('move_node.jstree', function(e, data) {
        $.ajax({
            type: "POST",
            url: "@Url.Action("MoverRutasDocumentos", "Documentos")",
            async: false,
            data: JSON.stringify({ "NdN": { "Idtemporal": data.node.id, "IdPadre": data.node.parent == '#' ? '0' : data.node.parent } }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function(data) {
                $.notify(data.Id == 1 ? "Carpeta movida" : "Error al mover", data.Id == 1 ? "success" : "error");
            }
        });
    });
});
</script>

<!-- IMÁGENES -->
<script>
    const dropArea = document.getElementById('dropArea');
    const fileInput = document.getElementById('fileInput');
    const preview = document.getElementById('preview');
    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg', 'image/bmp', 'image/tiff', 'image/webp'];

    if (dropArea) {
        dropArea.addEventListener('click', () => fileInput.click());

        ['dragenter', 'dragover'].forEach(ev => {
            dropArea.addEventListener(ev, e => {
                e.preventDefault();
                dropArea.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(ev => {
            dropArea.addEventListener(ev, e => {
                e.preventDefault();
                dropArea.classList.remove('dragover');
            });
        });

        dropArea.addEventListener('drop', e => {
            fileInput.files = e.dataTransfer.files;
            if (e.dataTransfer.files.length > 0) uploadImages(e.dataTransfer.files);
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) uploadImages(fileInput.files);
        });
    }

    function uploadImages(files) {
        const invalid = Array.from(files).filter(f => !allowedTypes.includes(f.type));
        if (invalid.length > 0) {
            swal({ title: "Solo imágenes permitidas", icon: "info", button: "Aceptar" });
            return;
        }

        const formData = new FormData();
        Array.from(files).forEach(f => formData.append("files", f));

        fetch('/Imagen/SubirImagen', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(data => { if (data.success) loadSessionImages(); });
    }

    function loadSessionImages() {
        fetch('/Imagen/ObtenerImagenesSesion')
            .then(r => r.json())
            .then(images => {
                preview.innerHTML = '';
                images.forEach(img => {
                    const div = document.createElement('div');
                    div.className = 'image-preview-item';
                    div.innerHTML = `
                    <img src="/Imagen/VerImagen?nombre=${img.NmArchivo}">
                    <button class="delete-btn" onclick="deleteImage('${img.NmArchivo}')">&times;</button>
                `;
                    preview.appendChild(div);
                });
            });
    }

    async function deleteImage(nombre) {
        const resp = await fetch('/Imagen/EliminarImagen', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `nombre=${encodeURIComponent(nombre)}`
        });
        const result = await resp.json();
        if (result.success) loadSessionImages();
    }

    document.addEventListener('DOMContentLoaded', loadSessionImages);
</script>
