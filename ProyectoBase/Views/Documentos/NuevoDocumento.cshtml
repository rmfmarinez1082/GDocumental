function ValidaTDoc(Id) {
    $("#DatosRequeridos").css("display", "block");

    if (Id == 11) {
        $("#Word, #Rpdf, #mensaje, #Pdf, #archivitos, #Visualizacion, #BtnPublicar").hide();
        $("#imagenes, #Cimagenes, #BtnPublicarIMG").show();
    } else {
        $.ajax({
            type: "POST",
            url: "@Url.Action("RequiereEditable", "Documentos")",
            async: false,
            data: JSON.stringify({ "TDoc": { "Id": Id } }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function(data) {
                if (data.Id === 1) {
                    $("#Word, #Rpdf, #mensaje, #Pdf, #Visualizacion, #archivitos, #BtnPublicar").show();
                    $("#imagenes, #Cimagenes, #BtnPublicarIMG").hide();
