function buscarDocumento() {
    var searchText = $('#placeholderSearchInput').val().trim();
    ejecutarBusqueda(searchText);
}

    function ejecutarBusqueda(searchText) {
        var jstreeInstance = $('#jstree').jstree(true);
        if (!jstreeInstance) return;

        // Si está vacío, limpiar búsqueda y mostrar todo
        if (!searchText) {
            jstreeInstance.clear_search();
            return;
        }

        // Asegurarse de que estamos en la pestaña "Todas las Carpetas"
        $('.directorio-tab').removeClass('active');
        $('.directorio-tab[data-tab="todas-carpetas"]').addClass('active');
        $('.directorio-tab-content').removeClass('active');
        $('#tab-todas-carpetas').addClass('active');

        // Ejecutar búsqueda
        jstreeInstance.search(searchText);
    }

// Enter para buscar en placeholder
    $('#placeholderSearchInput').on('keyup', function () {
        var searchText = $(this).val().trim();
        ejecutarBusqueda(searchText);
    });

// Buscar desde el visor
    // Búsqueda en tiempo real desde el visor
    $('#visorSearchInput').on('keyup', function () {
        var searchText = $(this).val().trim();
        ejecutarBusqueda(searchText);
    });

    // Búsqueda en tiempo real desde el visor
    $('#visorSearchInput').on('keyup', function () {
        var searchText = $(this).val().trim();
        ejecutarBusqueda(searchText);
    });

// ============================================
// VISOR DE DOCUMENTOS - PANEL CON PLACEHOLDER
// ============================================
function mostrarVisor() {
    $('#placeholderPanel').hide();
    $('#visorHeader').show();
    $('#visorSearchBar').addClass('visible');
    $('#visorContent').show();
}

function cerrarVisor() {
    $('#visorHeader').hide();
    $('#visorSearchBar').removeClass('visible');
    $('#visorContent').hide();
    $('#placeholderPanel').show();
    $('#iframepdf').attr('src', '');
    $('#Titulo').text('Visor de documentos');
    $('#vistafull').html('');
    $('#visorSearchInput').val('');

    // Limpiar búsqueda del jstree
    var jstreeInstance = $('#jstree').jstree(true);
    if (jstreeInstance) {
        jstreeInstance.clear_search();
    }

    // Quitar selección de filas
    $('.directorio-docs-table tbody tr').removeClass('selected');
}

function seleccionarDocumento(id) {
    // Marcar fila como seleccionada
    $('.directorio-docs-table tbody tr').removeClass('selected');
    $(`.directorio-docs-table tbody tr[data-id="${id}"]`).addClass('selected');

    // Mostrar visor
    mostrarVisor();

    var obj = { 'Id': id };

    $.ajax({
        url: "@Url.Action("SeleccionarPorId", "Documentos")",
        data: JSON.stringify({ "list_Doc": obj }),
        type: "POST",
        contentType: "application/json",
        dataType: "json",
        success: function (resultado) {
            if (resultado && resultado.length > 0) {
                $('#Titulo').text('Documento: ' + resultado[0].Nombre);
                $('#iframepdf').attr('src', '/DocumentosTemporales/' + resultado[0].NmArchivo + '#toolbar=0');

                var botonVistaCompleta = '<button class="btn waves-effect waves-light btn-info btn-sm" onclick="vistaCompleta(' + id + ')"><i class="icofont icofont-eye-alt"></i> Vista Completa</button>';
                $('#vistafull').html(botonVistaCompleta);
            }
        },
        error: function (resultado) {
            console.error("Error de ejecución:", resultado);
            $.notify("Error al cargar el documento", "error");
        }
    });
}

// Mantener compatibilidad con función anterior
function SeleccionarPorId(id) {
    seleccionarDocumento(id);
}

