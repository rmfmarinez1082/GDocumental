
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout _Administracion.cshtml";
}

<div class="@*pcoded-content*@">
    <!-- Page-header start -->
    <div class="page-header">
        <div class="page-block">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="page-header-title">
                        <h5 class="m-b-10"> Directorio</h5>
                        <p class="m-b-0"> </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <ul class="breadcrumb-title">
                        <li class="breadcrumb-item">
                            <a href="/Administracion/PrincipalA"> <i class="fa fa-home"></i> </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="#!">Inicio</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="main-body">
    <div class="page-wrapper">
        <!-- Page-body start -->
        <div class="page-body">
            <div class="row">

                <div class="col-xl-12 col-md-12" id="Directorio">
                    <div class="card table-card">
                        <div class="card-header">
                            <h5>Directorio</h5>
                        </div>

                        <div class="card-body">


                            <div class="tab-pane fade active show" id="v-pills-home-icons" role="tabpanel" aria-labelledby="v-pills-home-tab-icons" style="width: 90%">
                                <div class="accordion accordion-secondary">

                                    @foreach (var item1 in ViewBag.dtClasificacionArchivo)
                                    {

                                        var encabezado = "heading" + item1.Id;
                                        var colapso = "colapso" + item1.Id;
                                        var gcolapso = "#colapso" + item1.Id;

                                        <div class="card">
                                            @*INICIO CARPETAS PADRE*@
                                            <div class="card-header collapsed" id="@encabezado" data-toggle="collapse" data-target="@gcolapso" aria-expanded="false" aria-controls="@colapso" role="button">
                                                <div class="span-icon">
                                                    <div class="fa fa-folder"></div>
                                                </div>
                                                <div class="span-title text-dark fw-bold">
                                                    @item1.Nombre
                                                </div>
                                                <div class="span-mode text-dark"></div>
                                            </div>
                                            @*FIN CARPETAS PADRE*@

                                            <div id="@colapso" class="collapse" aria-labelledby="@encabezado" data-parent="#accordion">
                                                <div class="card-body">
                                                    <!--INICIO Documentos Carpeta Padre-->
                                                    @{
                                                        List<ProyectoBase.Models.Cat_ClasificacionArchivo> List = ProyectoBase.Models.Test.SP_DocPadre(item1);

                                                        if (List.Count() > 0)
                                                        {

                                                            <table id="Tclasificacion" class="table table-striped table-hover table-bordered table-head-bg-warning table-responsive-lg" width="100%">
                                                                <thead class="table-active">
                                                                    <tr>
                                                                        <th>Nombre</th>

                                                                    </tr>
                                                                </thead>
                                                                <tbody>

                                                                    @foreach (var datos in List)
                                                                    {
                                                                        <tr>
                                                                            <td><i class="fa fa-file-pdf-o"></i>&nbsp;&nbsp;@datos.Nombre</td>
                                                                        </tr>

                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <span class="">No se han agregado documentos.</span>
                                                        }
                                                    }
                                                    <!--FIN Documentos Carpeta Padre-->

                                                    

                                                    @foreach (var itemss in ProyectoBase.Models.Test.Cat_SubClasificacionArchivo_listar(item1))
                                                    {
                                                        var encabezadoo = "headingg" + itemss.Id;
                                                        var colapsoo = "colapsoo" + itemss.Id;
                                                        var gcolapsoo = "#colapsoo" + itemss.Id;
                                                        <div class="card">
                                                            @*INICIO CARPETAS Hijo*@
                                                            <div class="card-header collapsed" id="@encabezadoo" data-toggle="collapse" data-target="@gcolapsoo" aria-expanded="false" aria-controls="@colapsoo" role="button">
                                                                <div class="span-icon">
                                                                    <div class="fa fa-folder"></div>
                                                                </div>
                                                                <div class="span-title text-dark">
                                                                    @itemss.Nombre
                                                                </div>
                                                                <div class="span-mode text-dark"></div>
                                                            </div>
                                                            @*FIN CARPETAS Hijo*@

                                                            <div id="@colapsoo" class="collapse" aria-labelledby="@encabezadoo" data-parent="#accordion">
                                                                <div class="card-body" style="background-color: gainsboro">


                                                                    <!--INICIO Documentos Hijo-->

                                                                    @{
                                                                        var valores = new ProyectoBase.Models.Cat_ClasificacionArchivo();

                                                                        valores.Id = item1.Id;
                                                                        valores.Idhijo = itemss.Id;

                                                                        List <ProyectoBase.Models.Cat_ClasificacionArchivo> Listhijo = ProyectoBase.Models.Test.SP_DocHijo(valores);

                                                                        if (Listhijo.Count() > 0)
                                                                        {
                                                                            <table id="TSubClasificacion" class="table table-striped table-hover table-bordered table-head-bg-primary table-responsive-lg">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th>Nombre</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var datoss in Listhijo)
                                                                                    {
                                                                                        <tr>
                                                                                            <td><i class="fa fa-file-pdf-o"></i>&nbsp;&nbsp;</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="">No se han agregado documentos.</span>
                                                                        }
                                                                    }

                                                                    <!--Fin Documentos Hijo-->

                                                                </div>
                                                            </div>
                                                        </div>
                                                    }













                                                </div>
                                            </div>


                                        </div>


                                    }
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/jquery/jquery.min.js"></script>


