// ============================================
// CLASE PAGINADOR
// ============================================
class TablePaginator {
    constructor(tableId, options = {}) {
        this.table = document.getElementById(tableId);
        if (!this.table) return;

        this.tbody = this.table.querySelector('tbody');
        this.rows = Array.from(this.tbody.querySelectorAll('tr'));
        this.filteredRows = [...this.rows];
        this.perPage = options.perPage || 10;
        this.currentPage = 1;

        this.paginationContainer = document.createElement('div');
        this.paginationContainer.className = 'directorio-pagination';
        this.table.parentNode.appendChild(this.paginationContainer);

        this.render();
    }

    get totalPages() {
        return Math.ceil(this.filteredRows.length / this.perPage);
    }

    get startIndex() {
        return (this.currentPage - 1) * this.perPage;
    }

    get endIndex() {
        return Math.min(this.startIndex + this.perPage, this.filteredRows.length);
    }

    showPage(page) {
        this.currentPage = Math.max(1, Math.min(page, this.totalPages || 1));
        this.rows.forEach(row => row.style.display = 'none');

        for (let i = this.startIndex; i < this.endIndex; i++) {
            if (this.filteredRows[i]) {
                this.filteredRows[i].style.display = '';
            }
        }

        this.renderPagination();
    }

    filter(searchText) {
        searchText = searchText.toLowerCase().trim();

        this.filteredRows = searchText
            ? this.rows.filter(row => row.textContent.toLowerCase().includes(searchText))
            : [...this.rows];

        this.currentPage = 1;
        this.showPage(1);
    }

    renderPagination() {
        const total = this.filteredRows.length;

        if (total === 0) {
            this.paginationContainer.innerHTML = '<span class="directorio-pagination-info">No se encontraron documentos</span>';
            return;
        }

        if (this.totalPages <= 1) {
            this.paginationContainer.innerHTML = `<span class="directorio-pagination-info">Mostrando ${total} documento${total !== 1 ? 's' : ''}</span>`;
            return;
        }

        let html = `
            <button ${this.currentPage === 1 ? 'disabled' : ''} data-page="${this.currentPage - 1}">
                <i class="fa fa-chevron-left"></i>
            </button>
        `;

        const pages = this.getPageNumbers();
        pages.forEach(p => {
            html += p === '...'
                ? '<button disabled>...</button>'
                : `<button class="${p === this.currentPage ? 'active' : ''}" data-page="${p}">${p}</button>`;
        });

        html += `
            <button ${this.currentPage === this.totalPages ? 'disabled' : ''} data-page="${this.currentPage + 1}">
                <i class="fa fa-chevron-right"></i>
            </button>
            <span class="directorio-pagination-info">${this.startIndex + 1}-${this.endIndex} de ${total}</span>
        `;

        this.paginationContainer.innerHTML = html;

        this.paginationContainer.querySelectorAll('button[data-page]').forEach(btn => {
            btn.addEventListener('click', () => {
                const page = parseInt(btn.dataset.page);
                if (!isNaN(page)) this.showPage(page);
            });
        });
    }

    getPageNumbers() {
        const total = this.totalPages;
        const current = this.currentPage;
        const delta = 2;
        const range = [];
        const rangeWithDots = [];

        for (let i = 1; i <= total; i++) {
            if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
                range.push(i);
            }
        }

        let prev = null;
        for (const i of range) {
            if (prev !== null) {
                if (i - prev === 2) {
                    rangeWithDots.push(prev + 1);
                } else if (i - prev !== 1) {
                    rangeWithDots.push('...');
                }
            }
            rangeWithDots.push(i);
            prev = i;
        }

        return rangeWithDots;
    }

    render() {
        this.showPage(1);
    }
}

