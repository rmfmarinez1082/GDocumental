    function Eliminar(id) {
        swal({
            title: "Eliminación de Archivos",
            text: "¿Está seguro de querer eliminar este archivo?",
            icon: "error",
            buttons: {
                Si: {
                    text: "Sí, eliminar",
                    value: "si"

                },
                cancel: "Cancelar"
            },
            dangerMode: true,
        })
            .then((willDelete) => {

                switch (willDelete) {

                    case "si":
                        SeguroEliminarArchivo(id);
                        break;
                }
            });
