// ============================================
// SISTEMA DE PESTAÑAS
// ============================================
function initializeTabs() {
    $('.directorio-tab').on('click', function() {
        var tabName = $(this).data('tab');

        $('.directorio-tab').removeClass('active');
        $('.directorio-tab-content').removeClass('active');

        $(this).addClass('active');
        $('#tab-' + tabName).addClass('active');
    });
}

// ============================================
// FUNCIONES JSTREE
// ============================================
function createFolderAction() {
    var ref = $("#jstree").jstree(true);
    var sel = ref.get_selected();

    if (!sel.length) {
        $.notify("Seleccione primero un nodo", "warn");
        return;
    }

    sel = sel[0];
    sel = ref.create_node(sel);
    var nuevo = $("#jstree").jstree(true).get_node(sel);

    var obj = {
        "Nombre": nuevo.text,
        "IdPadre": nuevo.parent,
        "Idtemporal": nuevo.id
    };

    $.ajax({
        type: "POST",
        url: "@Url.Action("RegistrarSubClas", "Documentos")",
        async: false,
        data: JSON.stringify({ "nuevasubClas": obj }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {
            $("#BtnSubclas").trigger("click");
            if (data.Id == 1) {
                if (sel) ref.edit(sel);
            } else {
                ref.delete_node(sel);
            }
        }
    });
}

function renameFolderAction() {
    var ref = $("#jstree").jstree(true);
    var sel = ref.get_selected();

    if (!sel.length) {
        $.notify("Seleccione primero un nodo", "warn");
        return;
    }

    ref.edit(sel[0]);
}

function deleteFolderAction() {
    var ref = $("#jstree").jstree(true);
    var sel = ref.get_selected();

    if (!sel.length) {
        $.notify("Seleccione primero un nodo", "warn");
        return;
    }

    var obj = { "Idtemporal": sel[0] };

    $.ajax({
        type: "POST",
        url: "@Url.Action("EliminarCarpeta", "Documentos")",
        async: false,
        data: JSON.stringify({ "carpeta": obj }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {
            if (data.Id == 1) {
                ref.delete_node(sel[0]);
                $.notify("Carpeta eliminada!", "success");
            } else {
                swal({
                    title: "Esta carpeta no se puede eliminar ya que existe información que depende de esta.",
                    icon: "warning",
                    button: "Aceptar"
                });
            }
        }
    });
}

function createRootFolderAction() {
    $("#jstree").jstree("create_node", null, null, "last", function (node) {
        var obj = {
            "Nombre": node.text,
            "Idtemporal": node.id
        };

        $.ajax({
            type: "POST",
            url: "@Url.Action("RegistrarClas", "Documentos")",
            async: false,
            data: JSON.stringify({ "nuevaClas": obj }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.Id != 1) {
                    $.notify("El nombre de esta carpeta ya está en uso, renómbrela.", "error");
                }
            }
        });

        this.edit(node);
    });
}

function downloadEditableAction() {
    var ref = $("#jstree").jstree(true);
    var sel = ref.get_selected();

    if (!sel.length) {
        $.notify("Seleccione un documento primero", "warn");
        return;
    }

    var obj = { "Id": sel[0] };

    $.ajax({
        url: "@Url.Action("SeleccionarPorId", "Documentos")",
        data: JSON.stringify({ "list_Doc": obj }),
        type: "POST",
        contentType: "application/json",
        dataType: "json",
        success: function (data) {
            if (data && data.length > 0 && data[0].editable) {
                window.location.href = "/Documentos/descargar?doc=" + encodeURIComponent(data[0].editable) + "&nom=" + encodeURIComponent(data[0].Nombre);
            } else {
                $.notify("Este documento no tiene un editable disponible.", "warn");
            }
        },
        error: function () {
            $.notify("Error al intentar descargar el archivo editable.", "error");
        }
    });
}

function deleteDocumentAction() {
    var ref = $("#jstree").jstree(true);
    var sel = ref.get_selected();

    if (!sel.length) {
        $.notify("Seleccione primero un documento", "warn");
        return;
    }

    var obj = { "Id": sel[0] };

    swal({
        title: "Eliminación de Archivos",
        text: "¿Está seguro de querer eliminar este archivo?",
        icon: "error",
        buttons: {
            Si: { text: "Sí, eliminar", value: "si" },
            cancel: "Cancelar"
        },
        dangerMode: true
    }).then((willDelete) => {
        if (willDelete === "si") {
            $.ajax({
                url: "@Url.Action("QuitarArchivo", "Documentos")",
                data: JSON.stringify({ "documento": obj }),
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                success: function () {
                    ref.delete_node(sel[0]);
                    $.notify("Documento eliminado!", "success");
                },
                error: function () {
                    $.notify("Error al eliminar el documento", "error");
                }
            });
        }
    });
}

function buildContextMenu(node) {
    var isDocument = node.icon === 'fa fa-file-text';
    var menu = {};

    if (isDocument) {
        if (permissions.canDownloadEditable) {
            var ref = $("#jstree").jstree(true);
            var sel = ref.get_selected();

            if (sel.length > 0) {
                $.ajax({
                    url: "@Url.Action("SeleccionarPorId", "Documentos")",
                    data: JSON.stringify({ "list_Doc": { "Id": sel[0] } }),
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        if (data && data[0] && data[0].editable) {
                            menu["DescargarEditable"] = {
                                "label": "Descargar editable",
                                "action": downloadEditableAction
                            };
                        }
                    }
                });
            }
        }

        if (permissions.canDeleteDocument) {
            menu["eliminarDocumento"] = {
                "label": "Eliminar Documento",
                "action": deleteDocumentAction
            };
        }
    } else {
        menu["ccp"] = false;

        if (permissions.canCreateFolder) {
            menu["create"] = { "label": "Crear carpeta", "action": createFolderAction };
        }
        if (permissions.canRenameFolder) {
            menu["renombrar"] = { "label": "Renombrar Carpeta", "action": renameFolderAction };
        }
        if (permissions.canDeleteFolder) {
            menu["eliminar"] = { "label": "Eliminar Carpeta", "action": deleteFolderAction };
        }
        if (permissions.canCreateRootFolder) {
            menu["carpetaRoot"] = { "label": "Crear carpeta principal", "action": createRootFolderAction };
        }
    }

    return menu;
}

// ============================================
// INICIALIZACIÓN JSTREE
// ============================================
function initializeJsTree() {
    var plugins = ['state', 'wholerow', 'search'];

    if (permissions.canCreateFolder || permissions.canDeleteFolder || permissions.canDownloadEditable) {
        plugins.push('contextmenu');
    }

    if (permissions.canDragDrop) {
        plugins.push('dnd');
    }

    $('#jstree').jstree({
        'core': {
            'themes': { 'name': 'proton', 'responsive': true },
            'check_callback': permissions.canDragDrop
        },
        'plugins': plugins,
        'contextmenu': { items: buildContextMenu },
        'search': {
            'show_only_matches': true,
            'show_only_matches_children': true
        }
    });

    // Evento: Renombrar nodo
    if (permissions.canRenameFolder) {
        $('#jstree').on('rename_node.jstree', function (e, data) {
            data.node.text = data.text.toUpperCase();

            var obj = {
                "Nombre": data.node.text,
                "Idtemporal": data.node.id,
                "IdPadre": data.node.parent
            };

            $.ajax({
                type: "POST",
                url: "@Url.Action("Renombrar", "Documentos")",
                async: false,
                data: JSON.stringify({ "carpeta": obj }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.Id == 1) {
                        $.notify("Cambios Realizados.", "success");
                    } else if (data.Id == 2) {
                        $.notify("Elemento no editable.", "error");
                    } else {
                        $.notify("Error al procesar tu solicitud.", "error");
                    }
                }
            });
        });
    }

    // Evento: Mover nodo (drag and drop)
    if (permissions.canDragDrop) {
        $('#jstree').bind('move_node.jstree', function (e, data) {
            var isDocument = data.node.icon == "fa fa-file-text";
            var obj = {
                "Idtemporal": data.node.id,
                "IdPadre": data.node.parent == '#' ? '0' : data.node.parent
            };

            var url = isDocument
                ? "@Url.Action("MoverDocumento", "Documentos")"
                : "@Url.Action("MoverRutasDocumentos", "Documentos")";

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                data: JSON.stringify({ "NdN": obj }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    $("#BtnSubclas").trigger("click");
                    $.notify(data.Id == 1
                        ? (isDocument ? "Documento Reubicado." : "Carpeta Reubicada.")
                        : "No es posible mover a esta ruta.",
                        data.Id == 1 ? "success" : "error"
                    );
                }
            });
        });
    }
}

// ============================================
// BÚSQUEDA DESDE URL
// ============================================
function initializeSearchFromUrl() {
    var urlParams = new URLSearchParams(window.location.search);
    var nombreDocumento = urlParams.get('Doc');

    if (nombreDocumento && nombreDocumento !== 'null') {
        nombreDocumento = decodeURIComponent(nombreDocumento);
        $('#placeholderSearchInput').val(nombreDocumento);

        // Esperar a que jstree esté listo
        $('#jstree').on('ready.jstree', function() {
            ejecutarBusqueda(nombreDocumento);
        });
    }
}

// ============================================
// INICIALIZACIÓN PRINCIPAL
// ============================================
$(document).ready(function () {
    // Inicializar JsTree
    initializeJsTree();

    // Inicializar pestañas
    initializeTabs();

    // Inicializar paginadores
    var paginatorMisDocs = new TablePaginator('tablaMisDocumentos', { perPage: 8 });
    var paginatorCompartidos = new TablePaginator('tablaCompartidos', { perPage: 8 });

    // Conectar búsqueda con paginadores
    $('#searchMisDocs').on('keyup', function() {
        paginatorMisDocs.filter(this.value);
    });

    $('#searchCompartidos').on('keyup', function() {
        paginatorCompartidos.filter(this.value);
    });

    // Búsqueda desde URL
    initializeSearchFromUrl();
});
</script>
