                    <a href="#">
                        <div class="card" onclick="VDocVencido();" style="cursor:pointer">
                            <div class="card-block">
                                <div class="row align-items-center">
                                    <div class="col-8">
                                        <h4 class="text-c-red">
                                            @foreach (var item1 in ViewBag.ConteoVe)
