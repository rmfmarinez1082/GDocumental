            <div class="row">
                <!-- Docs Vigentes -->
                <div class="col-xl-6 col-md-12" id="DocVigente" style="display: none;">
                    <div class="card table-card">
                        <div class="card-header">
                            <h5>Documentos Vigentes</h5>
                            <div class="card-header-right">
                                <ul class="list-unstyled card-option">
                                    <li><i class="fa fa fa-wrench open-card-option"></i></li>
                                    <li><i class="fa fa-window-maximize full-card"></i></li>
                                    <li><i class="fa fa-minus minimize-card"></i></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-block p-15"  style="display: block;">
                            <div class="table-responsive">

                                <table id="TDocVigente" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th>
                                            <th class="text-center">Fecha de vencimiento</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ViewBag.lisvigente)
                                        {

                                            <tr>
                                                <td><i class="fa fa-file-text-o"></i>&nbsp;&nbsp;<a>@item.Nombre</a></td>
                                                <td class="text-center">@item.FechaVencimiento</td>
                                                <td class="text-center"><label class="label label-success">Vigente</label></td>
                                            </tr>

                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Docs Vencidos -->
                <div class="col-xl-6 col-md-12" id="DocVencido" style="display: none;">
                    <div class="card table-card">
                        <div class="card-header">
                            <h5>Documentos Vencidos</h5>
                            <div class="card-header-right">
                                <ul class="list-unstyled card-option">
                                    <li><i class="fa fa fa-wrench open-card-option"></i></li>
                                    <li><i class="fa fa-window-maximize full-card"></i></li>
                                    <li><i class="fa fa-minus minimize-card"></i></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-block p-15">
                            <div class="table-responsive">
                                <table id="TDocVencido" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th>
                                            <th class="text-center">Fecha de vencimiento</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ViewBag.lisvencido)
                                        {

                                            <tr>
                                                <td><i class="fa fa-file-text-o"></i>&nbsp;&nbsp;<a>@item.Nombre</a></td>
                                                <td class="text-center">@item.FechaVencimiento</td>
                                                <td class="text-center"><label class="label label-danger">Vencido</label></td>
                                            </tr>

                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>


        </div>
        <!-- Page-body end -->
    </div>
    <div id="styleSelector"> </div>
</div>

<script src="~/assets/js/jquery/jquery.min.js"></script>

<script>

    $(document).ready(function () {
        var counter = parseInt($('#counter').text());

        if (counter > 0) {
            $('#gif-icon').addClass('block');
        } else {
            $('#gif-icon').removeClass('block');
        }

    });

        var data = [{
      data: [@ViewBag.Visto ,@ViewBag.NVisto],

            backgroundColor: [
                "rgba(75,192,192,0.2)",
                "rgba(255,205,86,0.2)"

            ],
            borderColor: [
                "rgba(75,192,192,1)",
                "rgba(255,205,86,1)"
            ]
        }];
        var options = {
      tooltips: {
        enabled: true
      },
      plugins: {
        datalabels: {
          formatter: (value, ctx) => {

            let sum = ctx.dataset._meta[0].total;
            let percentage = (value * 100 / sum).toFixed(0) + "%";
            return percentage;


          },
              color: '#000000',
        }
      }
        };
        var ctx = document.getElementById("pie-chart").getContext('2d');
        var myChart = new Chart(ctx, {
        type: 'pie',
      data: {
      labels: ['Vistos', 'Pendientes'],
        datasets: data
      },
      options: options
});
</script>

<script>
    $(document).ready(function () {
        $('#TDocVigente').DataTable({

            pageLength: 5,
            lengthMenu: [[5, 10, 20, -1], [5, 10, 20, 'Todas']],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/es-MX.json'
            }
        });

        $('#TDocVencido').DataTable({
            pageLength: 5,
            lengthMenu: [[5, 10, 20, -1], [5, 10, 20, 'Todas']],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/es-MX.json'
            }
        });

       $('#TDocPVencer').DataTable({

            pageLength: 5,
            lengthMenu: [[5, 10, 20, -1], [5, 10, 20, 'Todas']],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.12.1/i18n/es-MX.json'
            }
        });
    });

    $('#IdMenuDashboard').addClass("active");

    function VDocVigente() {
        $("#DocVigente").css("display", "block");
    }
    function VDocVencido() {
        $("#DocVencido").css("display", "block");
    }
</script>
