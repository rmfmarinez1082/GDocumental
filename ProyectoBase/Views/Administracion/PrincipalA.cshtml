            <div class="row">
                <!-- Docs Proximos a vencer -->
                <div class="col-xl-8 col-md-12" id="ProxVencer" style="display: block;">
                    <div class="card table-card">
                        <div class="card-header">
                            <h5>Documentos Proximos a vencer</h5>
                            
                        </div>
                        <div class="p-15">
                            <div class="table-responsive">
                                <table id="TDocPVencer" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th>
                                            <th class="text-center">Fecha de vencimiento</th>
                                            <th class="text-center">Días Restantes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ViewBag.lisProx)
                                        {

                                            <tr>
                                                <td><i class="fa fa-file-text-o"></i>&nbsp;&nbsp;<a>@item.Nombre</a></td>
                                                <td class="text-center">@item.FechaVencimiento</td>
                                                <td class="text-center">@item.DiasRestantes</td>
                                            </tr>

