
@{
    ViewBag.Title = "AdminAreas";
    Layout = "~/Views/Shared/_Layout _Administracion.cshtml";
}
<style>
    .container {
        max-width: 1600px;
        margin: 0 auto;
    }

    .header {
        background: white;
        padding: 24px 30px;
        border-radius: 12px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .header h1 {
        color: #2c3e50;
        font-size: 24px;
        font-weight: 600;
    }

    .header p {
        color: #7f8c8d;
        font-size: 14px;
        margin-top: 4px;
    }

    .btn-add-area {
        padding: 10px 24px;
        background: #3498db;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }

        .btn-add-area:hover {
            background: #2980b9;
            transform: translateY(-1px);
        }

    .filters {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .search-box {
        flex: 1;
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #95a5a6;
        font-size: 16px;
    }

    .search-box input {
        width: 100%;
        padding: 10px 12px 10px 40px;
        border: 1px solid #e1e8ed;
        border-radius: 8px;
        font-size: 14px;
        color: #2c3e50;
        background: white;
    }

        .search-box input:focus {
            outline: none;
            border-color: #3498db;
        }

    .toolbar-actions {
        display: flex;
        gap: 12px;
    }

    .btn-toolbar {
        padding: 8px 16px;
        background: white;
        border: 1px solid #e1e8ed;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        color: #2c3e50;
        transition: all 0.2s;
    }

        .btn-toolbar:hover {
            border-color: #3498db;
            color: #3498db;
        }

    .legend {
        display: flex;
        gap: 20px;
        align-items: center;
        font-size: 13px;
        color: #7f8c8d;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

        .legend-dot.green {
            background: #2ecc71;
        }

        .legend-dot.red {
            background: #e74c3c;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: #3498db;
        }

    .stat-label {
        font-size: 13px;
        color: #7f8c8d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #2c3e50;
    }

    .main-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-title {
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
        padding: 24px 30px;
        border-bottom: 2px solid #f0f3f7;
    }

    .table-container {
        overflow-x: auto;
        max-height: 600px;
        overflow-y: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        position: sticky;
        top: 0;
        z-index: 10;
        background: white;
    }

    th {
        background: #f8f9fa;
        padding: 16px 20px;
        text-align: left;
        font-size: 13px;
        font-weight: 600;
        color: #7f8c8d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e1e8ed;
    }

        th:first-child {
            position: sticky;
            left: 0;
            background: #f8f9fa;
            z-index: 11;
            min-width: 400px;
        }

        th.area-header {
            text-align: center;
            min-width: 150px;
        }

    td {
        padding: 16px 20px;
        border-bottom: 1px solid #f0f3f7;
        font-size: 14px;
        color: #2c3e50;
    }

        td:first-child {
            position: sticky;
            left: 0;
            background: white;
            z-index: 5;
            font-weight: 500;
            border-right: 2px solid #f0f3f7;
        }

    tr:hover {
        background: #f8f9fa;
    }

        tr:hover td:first-child {
            background: #f8f9fa;
        }

    tr.hidden {
        display: none;
    }

    .folder-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .expand-btn {
        width: 24px;
        height: 24px;
        border: none;
        background: #f0f3f7;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #7f8c8d;
        font-size: 12px;
        transition: all 0.2s;
        flex-shrink: 0;
    }

        .expand-btn:hover {
            background: #e1e8ed;
            color: #3498db;
        }

        .expand-btn.expanded {
            background: #3498db;
            color: white;
        }

        .expand-btn.no-children {
            visibility: hidden;
        }

    .folder-info {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .folder-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        flex-shrink: 0;
    }

    .folder-details {
        display: flex;
        flex-direction: column;
    }

    .folder-name {
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .folder-count {
        font-size: 11px;
        color: #95a5a6;
        font-weight: 400;
    }

    .folder-meta {
        font-size: 12px;
        color: #95a5a6;
        margin-top: 2px;
    }

    /* Niveles de indentación */
    .level-0 .folder-cell {
        padding-left: 0;
    }

    .level-1 .folder-cell {
        padding-left: 32px;
    }

    .level-2 .folder-cell {
        padding-left: 64px;
    }

    .level-3 .folder-cell {
        padding-left: 96px;
    }

    .level-4 .folder-cell {
        padding-left: 128px;
    }

    .level-1 .folder-icon {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        width: 32px;
        height: 32px;
        font-size: 16px;
    }

    .level-2 .folder-icon {
        background: linear-gradient(135deg, #1abc9c 0%, #16a085 100%);
        width: 28px;
        height: 28px;
        font-size: 14px;
    }

    .level-3 .folder-icon {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        width: 24px;
        height: 24px;
        font-size: 12px;
    }

    .permission-cell {
        text-align: center;
    }

    .checkbox-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .checkbox-wrapper input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #3498db;
        }

    .area-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .area-count {
        display: block;
        font-size: 11px;
        color: #95a5a6;
        font-weight: 400;
        margin-top: 4px;
        text-transform: none;
        letter-spacing: normal;
    }

    .actions-bar {
        padding: 20px 30px;
        background: #f8f9fa;
        border-top: 1px solid #e1e8ed;
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn-action {
        padding: 10px 20px;
        border: 1px solid #e1e8ed;
        background: white;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        color: #2c3e50;
    }

        .btn-action:hover {
            border-color: #3498db;
            color: #3498db;
        }

        .btn-action.primary {
            background: #3498db;
            color: white;
            border-color: #3498db;
        }

            .btn-action.primary:hover {
                background: #2980b9;
                border-color: #2980b9;
                color: white;
            }

        .btn-action.danger {
            background: #e74c3c;
            color: white;
            border-color: #e74c3c;
        }

            .btn-action.danger:hover {
                background: #c0392b;
                border-color: #c0392b;
            }

    .spacer {
        flex: 1;
    }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal {
        background: white;
        border-radius: 12px;
        padding: 30px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

        .modal h2 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-size: 20px;
        }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #2c3e50;
            font-size: 14px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #e1e8ed;
            border-radius: 8px;
            font-size: 14px;
        }

            .form-group input:focus,
            .form-group select:focus {
                outline: none;
                border-color: #3498db;
            }

    .color-options {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .color-option {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.2s;
    }

        .color-option:hover,
        .color-option.selected {
            transform: scale(1.1);
            border-color: #2c3e50;
        }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 24px;
    }

    /* Toast Notification */
    .toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: #2ecc71;
        color: white;
        padding: 16px 24px;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        display: none;
        align-items: center;
        gap: 10px;
        z-index: 1001;
        animation: slideIn 0.3s ease;
    }

        .toast.error {
            background: #e74c3c;
        }

        .toast.show {
            display: flex;
        }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* Checkbox styling */
    input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #3498db;
        border-radius: 4px;
    }

    @@media (max-width: 768px) {
        .header-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .filters {
            flex-direction: column;
            width: 100%;
        }

        .search-box {
            width: 100%;
        }

        .legend {
            display: none;
        }
    }
</style>


<div class="container">
    <div class="header">
        <div class="header-top">
            <div>
                <h1>Matriz de Permisos por Áreas</h1>
                <p>Gestión de accesos a carpetas del sistema documental</p>
            </div>
        </div>
        <div class="filters">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" id="searchInput" placeholder="Buscar carpeta..." oninput="filterFolders(this.value)">
            </div>
            <div class="toolbar-actions">
                <button class="btn-toolbar" onclick="expandAll()">Expandir Todo</button>
                <button class="btn-toolbar" onclick="collapseAll()">Colapsar Todo</button>
            </div>
        </div>
    </div>

    <div class="main-card">
        <h2 class="card-title">Gestión de Accesos</h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Estructura de Carpetas</th>
                        <!-- Los headers de áreas se generan dinámicamente -->
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <!-- Las filas se generan dinámicamente -->
                </tbody>
            </table>
        </div>
        <div class="actions-bar">
            <button class="btn-action" onclick="selectAll()">Seleccionar Todo</button>
            <button class="btn-action" onclick="clearAll()">Limpiar Todo</button>
            <div class="spacer"></div>
            <button class="btn-action danger" onclick="resetChanges()">Descartar Cambios</button>
            <button class="btn-action primary" id="btnGuardar" onclick="guardarPermisos()">💾 Guardar Cambios</button>
        </div>
    </div>

    <br />

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Carpetas</div>
            <div class="stat-value" id="totalFolders">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Áreas Activas</div>
            <div class="stat-value" id="totalAreas">6</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Permisos Otorgados</div>
            <div class="stat-value" id="permisosOtorgados">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Nivel de Acceso</div>
            <div class="stat-value" id="nivelSeguridad">0%</div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="toast" id="toast">
    <span id="toastMessage">Cambios guardados exitosamente</span>
</div>
<script src="~/assets/js/jquery/jquery.min.js"></script>

<script>
    $('#IdAdministrador').addClass("active pcoded-trigger");
    $('#AdminAreas').addClass("active");
        // Datos de las carpetas desde el servidor
        const foldersData = @Html.Raw(ViewBag.carpetasJson);

        // Función para generar color basado en el nombre del área
        function generateColorFromString(str, index, total) {
            const hueStep = 360 / total;
            const h = (index * hueStep + 15) % 360;

            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }

            const s = 55 + (Math.abs(hash) % 25);
            const l = 40 + (Math.abs(hash >> 8) % 15);

            return {
                bg: `hsl(${h}, ${s}%, 90%)`,
                text: `hsl(${h}, ${s}%, ${l}%)`
            };
        }

        // Áreas desde el servidor
        const areasFromServer = @Html.Raw(ViewBag.AreasJson);

        // Transformar al formato que necesitamos
        const areasData = areasFromServer.map((area, index) => ({
            id: area.Id,
            name: area.Nombre,
            users: area.CantidadUsuarios,
            colors: generateColorFromString(area.Nombre, index, areasFromServer.length)
        }));

        function renderAreasHeader() {
            const headerRow = document.querySelector('thead tr');
            const existingHeaders = headerRow.querySelectorAll('th.area-header');
            existingHeaders.forEach(th => th.remove());

            areasData.forEach(area => {
                const th = document.createElement('th');
                th.className = 'area-header';
                th.innerHTML = `
                    <span class="area-badge" style="background: ${area.colors.bg}; color: ${area.colors.text};">
                        ${area.name}
                    </span>
                    <span class="area-count">${area.users} usuarios</span>
                `;
                headerRow.appendChild(th);
            });
        }

        // Estado de las carpetas expandidas
        const expandedFolders = new Set();

        // Estado original de permisos (para descartar cambios)
        let originalPermissions = {};

        // Inicialización
        window.addEventListener('load', async () => {
            renderAreasHeader();
            await cargarPermisosGuardados(); // Cargar permisos de BD primero
            saveOriginalPermissions();       // Guardar estado original después de cargar
            renderTable();
            updateStats();
        });

        // =====================================================
        // CARGAR PERMISOS DESDE BASE DE DATOS
        // =====================================================
        async function cargarPermisosGuardados() {
            try {
                const response = await fetch('@Url.Action("ObtenerPermisosAreas", "Administracion")');
                const result = await response.json();

                if (result.success && result.data) {
                    result.data.forEach(permiso => {
                        // Buscar el índice del área en areasData usando IdArea (NO IdCarpeta)
                        const areaIndex = areasData.findIndex(a => a.id === permiso.IdArea);
                        if (areaIndex !== -1) {
                            // Actualizar el estado de la carpeta con el IdCarpeta correcto
                            actualizarEstadoCarpeta(permiso.IdCarpeta, areaIndex, true);
                        }
                    });

                    console.log(`✓ ${result.data.length} permisos cargados desde BD`);
                }
            } catch (error) {
                console.error('Error al cargar permisos:', error);
                showToast('Error al cargar permisos guardados', true);
            }
        }

        // Función auxiliar para actualizar estado interno
        function actualizarEstadoCarpeta(folderId, areaIndex, value) {
            function buscarYActualizar(folders) {
                for (let folder of folders) {
                    if (folder.id == folderId) {
                        folder.permissions[areaIndex] = value;
                        return true;
                    }
                    if (folder.children && folder.children.length > 0) {
                        if (buscarYActualizar(folder.children)) return true;
                    }
                }
                return false;
            }
            buscarYActualizar(foldersData);
        }

        // =====================================================
        // GUARDAR PERMISOS EN BASE DE DATOS
        // =====================================================
        async function guardarPermisos() {
            const btnGuardar = document.getElementById('btnGuardar');
            const textoOriginal = btnGuardar.innerHTML;

            try {
                btnGuardar.disabled = true;
                btnGuardar.innerHTML = '<span>⏳</span> Guardando...';

                // Recolectar todos los permisos activos
                const permisosActivos = [];

                function recolectarPermisos(folders) {
                    for (let folder of folders) {
                        folder.permissions.forEach((tiene, index) => {
                            if (tiene) {
                                permisosActivos.push({
                                    idCarpeta: parseInt(folder.id),
                                    idArea: areasData[index].id
                                });
                            }
                        });

                        if (folder.children && folder.children.length > 0) {
                            recolectarPermisos(folder.children);
                        }
                    }
                }

                recolectarPermisos(foldersData);

                // Enviar al servidor
                const formData = new FormData();
                formData.append('permisosJson', JSON.stringify(permisosActivos));

                const response = await fetch('@Url.Action("GuardarPermisosAreas", "Administracion")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    saveOriginalPermissions(); // Actualizar estado original
                    showToast('✓ Permisos guardados correctamente');
                } else {
                    showToast('✗ Error: ' + result.message, true);
                }

            } catch (error) {
                console.error('Error al guardar:', error);
                showToast('✗ Error de conexión', true);
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = textoOriginal;
            }
        }

        function saveOriginalPermissions() {
            originalPermissions = {};
            function traverse(folders) {
                folders.forEach(folder => {
                    originalPermissions[folder.id] = [...folder.permissions];
                    if (folder.children && folder.children.length > 0) {
                        traverse(folder.children);
                    }
                });
            }
            traverse(foldersData);
        }

        function decodeHtmlEntities(text) {
            const textarea = document.createElement('textarea');
            textarea.innerHTML = text;
            return textarea.value;
        }

        function countDocumentsRecursive(folder) {
            let total = folder.documentsCount || 0;
            if (folder.children && folder.children.length > 0) {
                folder.children.forEach(child => {
                    total += countDocumentsRecursive(child);
                });
            }
            return total;
        }

        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            function renderFolder(folder, parentId = null, parentPath = '') {
                const isExpanded = expandedFolders.has(folder.id);
                const hasChildren = folder.children && folder.children.length > 0;

                let isHidden = false;
                if (parentId) {
                    let pathParts = parentPath.split('/').filter(p => p);
                    for (let i = pathParts.length - 1; i >= 0; i--) {
                        if (!expandedFolders.has(pathParts[i])) {
                            isHidden = true;
                            break;
                        }
                    }
                }

                const row = document.createElement('tr');
                row.className = `level-${folder.level}${isHidden ? ' hidden' : ''}`;
                row.dataset.id = folder.id;
                row.dataset.level = folder.level;
                if (parentId) {
                    row.dataset.parent = parentId;
                    row.dataset.path = parentPath;
                }

                const childCount = hasChildren ? `<span class="folder-count">(${folder.children.length})</span>` : '';
                const folderName = decodeHtmlEntities(folder.name);

                const totalDocs = countDocumentsRecursive(folder);
                const docsLabel = totalDocs > 0 ? `<span class="folder-meta">${totalDocs} documento${totalDocs !== 1 ? 's' : ''}</span>` : '';

                // Generar checkboxes con data attributes
                let checkboxesHtml = '';
                folder.permissions.forEach((perm, index) => {
                    checkboxesHtml += `
                        <td class="permission-cell">
                            <input type="checkbox"
                                   ${perm ? 'checked' : ''}
                                   data-folder-id="${folder.id}"
                                   data-area-index="${index}"
                                   onchange="updatePermission('${folder.id}', ${index}, this.checked)">
                        </td>
                    `;
                });

                row.innerHTML = `
                    <td>
                        <div class="folder-cell">
                            <button class="expand-btn ${isExpanded ? 'expanded' : ''} ${!hasChildren ? 'no-children' : ''}"
                                    onclick="toggleFolder('${folder.id}')">
                                ${isExpanded ? '▼' : '▶'}
                            </button>
                            <div class="folder-info">
                                <div class="folder-icon">📁</div>
                                <div class="folder-details">
                                    <span class="folder-name">
                                        ${folderName}
                                        ${childCount}
                                    </span>
                                    ${docsLabel}
                                </div>
                            </div>
                        </div>
                    </td>
                    ${checkboxesHtml}
                `;

                tbody.appendChild(row);

                if (hasChildren) {
                    const newPath = parentPath ? `${parentPath}/${folder.id}` : folder.id;
                    folder.children.forEach(child => {
                        renderFolder(child, folder.id, newPath);
                    });
                }
            }

            foldersData.forEach(folder => renderFolder(folder));
            updateStats();
        }

        function toggleFolder(folderId) {
            if (expandedFolders.has(folderId)) {
                collapseRecursive(folderId);
            } else {
                expandedFolders.add(folderId);
            }
            renderTable();
        }

        function collapseRecursive(folderId) {
            expandedFolders.delete(folderId);

            function findAndCollapse(folders) {
                folders.forEach(folder => {
                    if (folder.id === folderId) {
                        function collapseChildren(children) {
                            children.forEach(child => {
                                expandedFolders.delete(child.id);
                                if (child.children && child.children.length > 0) {
                                    collapseChildren(child.children);
                                }
                            });
                        }
                        if (folder.children) collapseChildren(folder.children);
                    }
                    if (folder.children && folder.children.length > 0) {
                        findAndCollapse(folder.children);
                    }
                });
            }
            findAndCollapse(foldersData);
        }

        function expandAll() {
            function addAll(folders) {
                folders.forEach(folder => {
                    if (folder.children && folder.children.length > 0) {
                        expandedFolders.add(folder.id);
                        addAll(folder.children);
                    }
                });
            }
            addAll(foldersData);
            renderTable();
        }

        function collapseAll() {
            expandedFolders.clear();
            renderTable();
        }

        function updatePermission(folderId, areaIndex, value) {
            function findAndUpdate(folders) {
                for (let folder of folders) {
                    if (folder.id === folderId) {
                        folder.permissions[areaIndex] = value;
                        return true;
                    }
                    if (folder.children && folder.children.length > 0) {
                        if (findAndUpdate(folder.children)) return true;
                    }
                }
                return false;
            }
            findAndUpdate(foldersData);
            updateStats();
        }

        function updateStats() {
            let totalPermissions = 0;
            let grantedPermissions = 0;
            let totalFolders = 0;

            function countPermissions(folders) {
                folders.forEach(folder => {
                    totalFolders++;
                    folder.permissions.forEach(perm => {
                        totalPermissions++;
                        if (perm) grantedPermissions++;
                    });
                    if (folder.children && folder.children.length > 0) {
                        countPermissions(folder.children);
                    }
                });
            }

            countPermissions(foldersData);

            const percentage = totalPermissions > 0 ? Math.round((grantedPermissions / totalPermissions) * 100) : 0;

            document.getElementById('permisosOtorgados').textContent = grantedPermissions;
            document.getElementById('nivelSeguridad').textContent = percentage + '%';
            document.getElementById('totalFolders').textContent = totalFolders;
            document.getElementById('totalAreas').textContent = areasData.length;
        }

        function filterFolders(searchTerm) {
            const rows = document.querySelectorAll('#tableBody tr');
            const term = searchTerm.toLowerCase().trim();

            if (term === '') {
                renderTable();
                return;
            }

            rows.forEach(row => row.classList.remove('hidden'));

            rows.forEach(row => {
                const folderName = row.querySelector('.folder-name').textContent.toLowerCase();
                if (!folderName.includes(term)) {
                    row.classList.add('hidden');
                } else {
                    let currentRow = row;
                    while (currentRow.dataset.parent) {
                        const parentRow = document.querySelector(`tr[data-id="${currentRow.dataset.parent}"]`);
                        if (parentRow) {
                            parentRow.classList.remove('hidden');
                            const btn = parentRow.querySelector('.expand-btn');
                            if (btn && !btn.classList.contains('no-children')) {
                                btn.classList.add('expanded');
                                btn.textContent = '▼';
                            }
                            currentRow = parentRow;
                        } else {
                            break;
                        }
                    }
                }
            });
        }

        function selectAll() {
            function setAll(folders, value) {
                folders.forEach(folder => {
                    folder.permissions = folder.permissions.map(() => value);
                    if (folder.children && folder.children.length > 0) {
                        setAll(folder.children, value);
                    }
                });
            }
            setAll(foldersData, true);
            renderTable();
            showToast('Todos los permisos seleccionados');
        }

        function clearAll() {
            function setAll(folders, value) {
                folders.forEach(folder => {
                    folder.permissions = folder.permissions.map(() => value);
                    if (folder.children && folder.children.length > 0) {
                        setAll(folder.children, value);
                    }
                });
            }
            setAll(foldersData, false);
            renderTable();
            showToast('Todos los permisos eliminados');
        }

        function resetChanges() {
            function restore(folders) {
                folders.forEach(folder => {
                    if (originalPermissions[folder.id]) {
                        folder.permissions = [...originalPermissions[folder.id]];
                    }
                    if (folder.children && folder.children.length > 0) {
                        restore(folder.children);
                    }
                });
            }
            restore(foldersData);
            renderTable();
            showToast('Cambios descartados');
        }

        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');

            toastMessage.textContent = message;
            toast.className = 'toast show' + (isError ? ' error' : '');

            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }
</script>