
@{
    ViewBag.Title = "GaleriaDeImagenes";
    Layout = "~/Views/Shared/_Layout _Administracion.cshtml";
}


<!-- CSS de LightGallery -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/css/lightgallery.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/css/lg-zoom.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/css/lg-thumbnail.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/css/lg-video.css">


<!-- Estilo para mantener la apariencia similar a tu diseño original -->
<style>
    .box-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        list-style: none;
        padding: 0;
        margin: 20px 0;
    }

    .three-cols .box {
        flex: 0 0 calc(33.333% - 14px);
        margin-bottom: 20px;
    }

    .box .inner {
        border-radius: 5px;
        overflow: hidden;
        position: relative;
    }

    .box .inner img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
        cursor: pointer;
    }

    .box .inner img:hover {
        transform: scale(1.05);
    }

    .lg-custom-desc {
        display: none;
    }


    .box {
        width: 200px;
        height: 200px;
        overflow: hidden;
        margin-bottom: 15px;
        border-radius: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Sombra sutil */
    }

    .box img {
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    transition: transform 0.3s ease; 
    }

    .box img:hover {
        transform: scale(1.05);
    }

</style>

<br />

<section class="section pair">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3>
                    <i class="fa fa-camera-retro heading-icon" aria-hidden="true"></i>
                    Galería de Imágenes
                </h3>
                <p>
                    Explora nuestra colección de fotografías.
                    <strong>Haz clic en cualquier imagen para ampliarla</strong>.
                </p>

                <!-- Contenedor de la galería con LightGallery -->
                <div id="lightgallery" class="box-container three-cols">
                    @if (ViewBag.Imagenes != null)
                    {
                        foreach (var item in ViewBag.Imagenes)
                        {
                            <div class="box">
                                <div class="inner">
                                    @*<p>@item.NmOriginal</p>*@
                                    <a href="@item.RutaCompleta"
                                       data-sub-html='@item.NmOriginal'>
                                        <img src="@item.RutaCompleta" alt="image" class="img-responsive" />
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Sin imágenes</p>
                    }



                </div>
            </div>
        </div>
    </div>
</section>




<script src="~/assets/js/jquery/jquery.min.js"></script>

<!-- JavaScript de LightGallery y plugins -->
<script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/lightgallery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/plugins/zoom/lg-zoom.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/plugins/thumbnail/lg-thumbnail.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/plugins/video/lg-video.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.1/plugins/fullscreen/lg-fullscreen.min.js"></script>

<!-- Script para inicializar LightGallery -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Verificar que lightGallery esté disponible
        if (typeof lightGallery === 'function') {
            // Inicializar lightGallery
            const lgContainer = document.getElementById('lightgallery');
            if (lgContainer) {
                lightGallery(lgContainer, {
                    selector: 'a',
                    speed: 500,
                    plugins: [lgZoom, lgThumbnail, lgFullscreen],
                    mode: 'lg-fade',
                    download: true,
                    counter: true,
                    enableDrag: true,
                    enableSwipe: true,
                    subHtmlSelectorRelative: false,
                    subHtmlSelectorAttribute: 'data-sub-html'
                });
                console.log('LightGallery inicializado correctamente');
            } else {
                console.error('Contenedor de galería no encontrado');
            }
        } else {
            console.error('LightGallery no está disponible. Verifica que la librería esté cargada.');
        }
    });

</script>




